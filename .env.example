ANTHROPIC_API_KEY=your_key_here

# --- AI model tiers (all optional — sensible defaults built in). ---
# Every generation runs through one of two tiers, each set as "provider/model":
#   fast     — small schema-bound menus (flights, transport, city ideas,
#              option detail sheets). Default: anthropic/claude-haiku-4-5
#   standard — the creative work (destination recs, routes, the board,
#              the final plan, revisions). Default: anthropic/claude-sonnet-5
# To try Google Gemini for either tier, set GEMINI_API_KEY (aistudio.google.com)
# and point a tier at it — failures fall back to the Anthropic default.
# e.g. LLM_FAST=gemini/gemini-2.5-flash
LLM_FAST=
LLM_STANDARD=
GEMINI_API_KEY=

# --- Database: leave unset for local SQLite (backend/data/rovyn.db). ---
# For Postgres/Supabase, paste the connection string from
# Supabase → Project Settings → Database → Connection string (Session pooler).
# URL-encode any special characters in the password.
DATABASE_URL=

# --- Supabase Auth (enables Google/Apple + Supabase email sign-in). ---
# Project URL from Supabase → Project Settings → API. Leave unset to keep
# the built-in email/password auth.
SUPABASE_URL=
# Only needed for older Supabase projects that sign JWTs with the legacy
# HS256 secret (Project Settings → API → JWT Secret). New projects use
# asymmetric keys discovered automatically via JWKS.
SUPABASE_JWT_SECRET=
# Dev/test only: set to 1 to keep the instant email/password signup
# (no verification email) available alongside Supabase Auth, so you can
# create fake test accounts freely. Leave unset on production deployments —
# there sign-ups go through Supabase and require email verification.
ALLOW_LEGACY_AUTH=

# Extra CORS origins for a hosted frontend, comma-separated
# e.g. https://rovyn.vercel.app
ALLOWED_ORIGINS=

# Optional: real email delivery for payment receipts (resend.com)
RESEND_API_KEY=
EMAIL_FROM="Rovyn <onboarding@resend.dev>"

# Optional: place & activity photos (pexels.com/api — free, 200 req/hour)
PEXELS_API_KEY=

# --- Phase A: booking checklist & live data (all optional, all free signups) ---
# Live hotel prices on the planning board (liteapi.travel — self-serve, free)
LITEAPI_API_KEY=
# Official hotel/venue websites (Google Places API)
GOOGLE_PLACES_API_KEY=
# Affiliate IDs — appended to deep links so bookings earn commission
VIATOR_PARTNER_ID=
GYG_PARTNER_ID=
BOOKING_AFFILIATE_AID=
EXPEDIA_AFFILIATE_ID=

# --- The wider board (docs/OPTIONS-BREADTH-SPEC.md) — all optional ---
# A second supply source for flights (duffel.com — self-serve test tokens are
# free; test inventory flies as "Duffel Airways" and is labeled test on the
# board). Airports resolve through LiteAPI, so this widens a board that has
# LITEAPI_API_KEY — on its own it searches nothing.
DUFFEL_ACCESS_TOKEN=
# Duffel accommodations on the Stay tab — only for LIVE Duffel Stays access
# (test mode serves synthetic test hotels only). Set to 1 to enable.
DUFFEL_STAYS=
# How far the net is cast (defaults shown)
# stays shown on a single-base trip
STAY_OPTIONS_SINGLE=12
# stays per city on a multi-city route (never fewer than voted styles + 3)
STAY_OPTIONS_PER_CITY=5
# flight itineraries per departure city
FLIGHT_OPTIONS_PER_CITY=8
# properties priced before choosing (capped at 60 per route city)
STAY_CANDIDATES=150
# wall-time budget, in seconds, for one city's whole stay search
STAY_SEARCH_DEADLINE_S=25
# LiteAPI pacing in requests per second (default 8; 4 on a sandbox key)
LITEAPI_RATE_PER_S=
