# Copy to frontend/.env.local (gitignored) to enable Supabase auth.
# Both values live in Supabase → Project Settings → API.
# Leave the file absent to use the built-in email/password auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Point the frontend at a hosted backend (defaults to http://localhost:8000)
# VITE_API_BASE=
